# Dependencies
node_modules/

# Build outputs
dist/
/extension/
*.tsbuildinfo
*.tgz
*.zip

# Turborepo
.turbo/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Environment
.env
.env.local
.env.*.local

# Test coverage
coverage/

# Scratch / verification dumps
temp_*.json
*.diff

# Build outputs (daemon bundle)
/daemon/
/resources/daemon/

# Local agent configs
.claude/
.reasonix/

# Daemon runtime artifacts (written to DAEMON_DIR = BB_BROWSER_HOME || ~/.bb-browser).
# These appear at the repo root only when BB_BROWSER_HOME is set to the repo
# (e.g. during local dev). Anchor to root so we never shadow a legit nested
# state/ or browser/ dir elsewhere.
/daemon.json
/token
/state/
/browser/
/logs/

# Vault runtime state (local dev; machine-specific vault registry + cached state)
/vault-registry.json
/vault-state/

# External site adapters repo (cloned separately, not part of this monorepo)
/bb-sites/
