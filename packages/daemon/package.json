{
  "name": "@ma-browser/daemon",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "bin": {
    "ma-browser-daemon": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "tsx --test src/__tests__/*.test.ts",
    "test:drift": "tsx --test src/__tests__/protocol-drift.test.ts",
    "lint": "eslint src tsup.config.ts --ignore-pattern 'src/**/*.d.ts'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ma-browser/shared": "workspace:*",
    "@ma-browser/vault": "workspace:^",
    "better-sqlite3": "^13.0.3",
    "chokidar": "^5.0.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.7.0",
    "ws": "^8.19.0"
  }
}
