{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ma-browser Tray",
  "version": "0.11.6",
  "identifier": "com.ma-browser.tray",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": "../src",
    "features": [
      "tauri-app"
    ]
  },
  "app": {
    "windows": [
      {
        "label": "popup",
        "title": "ma-browser",
        "url": "index.html",
        "width": 360,
        "height": 360,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "shadow": false,
        "minWidth": 360,
        "maxWidth": 360
      },
      {
        "label": "control-panel",
        "title": "ma-browser 控制面板",
        "url": "panel.html",
        "width": 960,
        "height": 680,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "visible": false,
        "focus": false,
        "shadow": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": [
      "icons/*.png",
      "../icons/tray-green.png",
      "../icons/tray-red.png",
      "../icons/tray-yellow.png",
      "../vendor/MicrosoftEdgeWebview2Setup.exe",
      "resources/node/*",
      "resources/daemon/*",
      "resources/daemon/node_modules/**/*",
      "resources/mcp/*",
      "resources/mcp-config.json"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
